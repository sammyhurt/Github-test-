# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ─── Admin ────────────────────────────────────────────────────────────────────
# Password for the /admin/waitlist page.
# Change this to a strong secret before deploying.
ADMIN_PASSWORD=changeme_before_deploy

# ─── Storage ──────────────────────────────────────────────────────────────────
# TODO: Replace SQLite with a hosted database for production.
# Options:
#   Firebase Firestore: https://firebase.google.com/docs/firestore
#   Supabase Postgres:  https://supabase.com/docs
#
# SQLite data lives at ./data/waitlist.db (git-ignored)

# ─── Analytics (optional) ─────────────────────────────────────────────────────
# Google Analytics measurement ID (GA4)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Segment write key
# NEXT_PUBLIC_SEGMENT_WRITE_KEY=your_segment_key

# ─── App ──────────────────────────────────────────────────────────────────────
# Base URL used for canonical tags and sitemaps
NEXT_PUBLIC_BASE_URL=http://localhost:3000
